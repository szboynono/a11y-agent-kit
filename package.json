{
  "name": "a11y-agent-kit",
  "version": "0.1.0",
  "description": "Local accessibility audit tools for your own coding agent: browser exploration, configurable WCAG 2.1/2.2 A/AA evidence (default 2.2 AA) and independently reviewed findings.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./schema": "./src/schema.js",
    "./server": "./src/server.js"
  },
  "bin": {
    "a11y-agent-kit": "./src/cli.js",
    "a11y-fix-loop": "./src/cli.js"
  },
  "files": [
    "src",
    "examples",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "llms.txt",
    "docs/mcp-images.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/cli.js serve"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/server": "2.4.0",
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
